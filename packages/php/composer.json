{
    "name": "authdog/authdog",
    "description": "Authdog PHP SDK — session cookie, OIDC userinfo, and PSR-15 / Laravel middleware.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Authdog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Authdog\\Tests\\": "tests/"
        }
    }
}
