{
    "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "nodenext",
      "declaration": true,
      "declarationDir": "dist/types",
      "emitDeclarationOnly": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "types": [],
      "jsx": "react-jsx",
      "allowImportingTsExtensions": true,
      "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "dist"]
}
  