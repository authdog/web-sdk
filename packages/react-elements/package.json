{
  "name": "@authdog/react-elements",
  "version": "0.0.9",
  "scripts": {
    "ui": "pnpm dlx shadcn@latest",
    "lint": "eslint .",
    "build:styles": "postcss src/global.css -o dist/styles.css",
    "build": "pnpm tsup && pnpm build:styles"
  },
  "peerDependencies": {
    "react": "catalog:react18"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "postcss-cli": "^11.0.1",
    "postcss-load-config": "^6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "exports": {
    ".": "./dist/index.js",
    "./global.css": "./dist/global.css",
    "./postcss.config": "./postcss.config.mjs",
    "./tailwind.config": "./tailwind.config.ts",
    "./lib/*": "./dist/lib/*.js",
    "./components/*": "./dist/components/ui/*.js",
    "./tailwind.preset": "./dist/tailwind.preset.js",
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
