{
    "name": "@authdog/react-elements",
    "version": "0.0.4",
    "description": "Authdog React Elements",
    "source": "src/index.ts",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./tailwind.config": {
            "types": "./dist/tailwind.config.d.ts",
            "import": "./dist/tailwind.config.mjs",
            "require": "./dist/tailwind.config.js"
        },
        "./global.css": "./src/global.css",
        "./postcss.config": "./postcss.config.mjs",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": [
            "./src/hooks/*.ts",
            "./src/hooks/*.tsx"
        ],
        "./components/*": "./src/components/*.tsx"
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "format": "prettier --config .prettierrc.json --write \"**/*.{ts,md}\"",
        "type-check": "tsc",
        "clean": "rm -rf dist",
        "build": "pnpm clean && tsup",
        "ship": "pnpm build && pnpm publish --access public --no-git-checks"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "dependencies": {
        "@authdog/node-commons": "workspace:*",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.487.0",
        "react": "^18.2.0",
        "tailwind-merge": "^3.2.0",
        "tw-animate-css": "^1.2.9"
    },
    "devDependencies": {
        "@types/node": "^22.14.1",
        "@types/react": "^18.2.0",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.1",
        "postcss-load-config": "^6",
        "tailwindcss": "^4.1.6"
    },
    "postcss": "./postcss.config.js"
}
