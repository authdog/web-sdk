{
  "name": "@authdog/react",
  "version": "0.1.0",
  "description": "Framework-agnostic Authdog React SDK — provider, hooks, and ready auth UI",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist/"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authdog-labs/web-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/authdog-labs/web-sdk/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/authdog-labs/web-sdk/issues"
  },
  "scripts": {
    "type-check": "tsc",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@authdog/node-commons": "workspace:*",
    "@authdog/react-elements": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
