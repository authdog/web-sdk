{
    "name": "@authdog/angular",
    "version": "0.3.0",
    "description": "Authdog Angular SDK",
    "source": "src/index.ts",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/authdog-labs/web-sdk.git",
        "directory": "packages/angular"
    },
    "homepage": "https://github.com/authdog-labs/web-sdk/tree/main/packages/angular#readme",
    "bugs": {
        "url": "https://github.com/authdog-labs/web-sdk/issues"
    },
    "scripts": {
        "format": "prettier --config .prettierrc.json --write \"**/*.{ts,md}\"",
        "type-check": "tsc",
        "clean": "rm -rf dist",
        "build": "bun run clean && tsup",
        "ship": "bun run build && bun publish --access public"
    },
    "dependencies": {
        "@authdog/node-commons": "workspace:*"
    },
    "peerDependencies": {
        "@angular/common": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
        "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
        "@angular/router": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@angular/common": "^20.3.25",
        "@angular/core": "^20.3.25",
        "@angular/router": "^20.3.25",
        "@types/node": "^26.0.0",
        "dotenv": "^17.0.0",
        "prettier": "^3.4.2",
        "rxjs": "^7.8.1",
        "tsup": "^8.3.5",
        "typescript": "^5.8.0",
        "vitest": "^3.2.6"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    }
}
