{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "declaration": true,
      "declarationDir": "dist/types",
      "emitDeclarationOnly": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "types": ["@types/node"],
      "jsx": "preserve",
      "allowImportingTsExtensions": true,
      "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
  }