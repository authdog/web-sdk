{
    "name": "@authdog/nextjs-app",
    "version": "1.0.2",
    "description": "Authdog Next.js SDK",
    "source": "src/index.ts",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./client": {
            "types": "dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "dist/index.server.d.ts",
            "import": "dist/index.server.js",
            "require": "dist/index.server.js"
        }
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "format": "prettier --config .prettierrc.json --write \"**/*.{ts,md}\"",
        "type-check": "tsc",
        "clean": "rm -rf dist",
        "build": "pnpm clean && tsup",
        "test": "vitest run",
        "ship": "pnpm build && pnpm publish --access public --no-git-checks"
    },
    "dependencies": {
        "next": "^15.4.8",
        "react": "catalog:react19"
    },
    "devDependencies": {
        "@types/next": "^9.0.0",
        "@types/node": "^22.10.5",
        "@types/react": "catalog:react19",
        "dotenv": "^16.4.7",
        "prettier": "^3.4.2",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    }
}