{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext", // Resolve Node.js modules
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["next"] // Include all Next.js types
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
