{
  "extends": "@authdog/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "~/*": ["./*"],
      "@authdog/ui/*": ["../packages/ui/*"],
      "@authdog/react-elements": ["../packages/react-elements"],
      "@authdog/react-elements/*": ["../packages/react-elements/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "postcss.config.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
