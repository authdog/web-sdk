{
  "name": "web-sdk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "lint": "moon run :lint",
    "check-types": "moon run :type-check",
    "test": "moon run :test",
    "ci": "moon ci",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish-packages": "moon run '#publishable:build' && bunx changeset publish",
    "generate-pr": "moon run '#publishable:build' && bunx changeset version"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@changesets/cli": "^2.28.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vercel": "^41.4.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.52.1"
  },
  "packageManager": "bun@1.2.11",
  "engines": {
    "node": ">=20.17.0",
    "bun": ">=1.2.11"
  }
}
