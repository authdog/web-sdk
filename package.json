{
  "name": "web-sdk",
  "private": true,
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "lint": "moon run :lint",
    "check-types": "moon run :type-check",
    "test": "moon run :test",
    "ci": "moon ci",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish-packages": "moon run '#publishable:build' && bunx changeset publish",
    "generate-pr": "moon run '#publishable:build' && bunx changeset version"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.0",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vercel": "^54.18.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=20.17.0",
    "bun": ">=1.2.15"
  }
}
