{
  "name": "web-sdk",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.14.1",
      "@types/react": "^19.1.0",
      "@types/react-dom": "^19.1.0",
      "@next/eslint-plugin-next": "16.1.6",
      "dotenv": "^16.4.7",
      "eslint": "^9.15.0",
      "next": "16.1.6",
      "prettier": "^3.4.2",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "tailwindcss": "^4.1.0",
      "@tailwindcss/postcss": "^4.1.0",
      "tw-animate-css": "^1.2.9",
      "tsup": "^8.3.5",
      "typescript": "^5.7.3",
      "vitest": "^2.1.8"
    }
  },
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "lint": "moon run :lint",
    "check-types": "moon run :type-check",
    "test": "moon run :test",
    "ci": "moon ci",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish-packages": "moon run '#publishable:build' && bunx changeset publish",
    "generate-pr": "moon run '#publishable:build' && bunx changeset version"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@changesets/cli": "^2.28.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "postcss-loader": "^8.1.1",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vercel": "^41.4.1",
    "vitest": "catalog:",
    "wrangler": "^4.52.1"
  },
  "packageManager": "bun@1.2.11",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.11"
  }
}
