{
  "name": "web-sdk-pnpm",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish-packages": "turbo build --filter=@authdog/*  --filter=!@playground/*  && pnpm changeset publish",
    "generate-pr": "turbo build --filter=@authdog/* --filter=!@playground/* && pnpm changeset version"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@changesets/cli": "^2.28.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.0",
    "js-yaml": "^4.1.0",
    "postcss-loader": "^8.1.1",
    "prettier": "catalog:",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vercel": "^41.4.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.52.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.17.0"
  },
  "volta": {
    "node": "20.19.5",
    "pnpm": "9.15.9"
  }
}
