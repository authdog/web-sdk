{
  "name": "web-sdk",
  "private": true,
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "moon run :build",
    "dev": "moon run :dev",
    "lint": "moon run :lint",
    "check-types": "moon run :type-check",
    "test": "moon run :test",
    "ci": "moon ci",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "publish-packages": "moon run '#publishable:build' && bunx changeset publish",
    "generate-pr": "moon run '#publishable:build' && bunx changeset version"
  },
  "devDependencies": {
    "@authdog/eslint-config": "workspace:*",
    "@authdog/typescript-config": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.0",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vercel": "^54.18.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tar": "7.5.22",
    "@xmldom/xmldom": "0.9.10",
    "undici": "6.27.0",
    "minimatch": "10.2.5",
    "path-to-regexp": "8.4.2",
    "piscina": "5.2.0",
    "vite": "8.2.2",
    "@remix-run/server-runtime": "2.17.5",
    "@remix-run/router": "1.23.3",
    "valibot": "1.4.1",
    "turbo-stream": "3.2.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "ip-address": "10.5.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.3"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=20.17.0",
    "bun": ">=1.2.15"
  }
}
